# Production — copy to `.env.production.local` (never commit secrets).
# Used by `npm run build:prod` / `npm run start:prod`.
# Vercel: set the same keys in Project → Settings → Environment Variables (Production).
# Netlify: Site configuration → Environment variables.
# NEXT_PUBLIC_* values are inlined into the client bundle at build time.

NEXT_PUBLIC_API_BASE_URL=https://your-api.example.com
NEXT_PUBLIC_CHAT_SOCKET_BASE_URL=https://your-api.example.com
NEXT_PUBLIC_CHAT_SOCKET_NAMESPACE=/chat

# Optional: notifications socket (falls back to API base when unset)
# NEXT_PUBLIC_NOTIFICATIONS_SOCKET_BASE_URL=https://your-api.example.com
# NEXT_PUBLIC_NOTIFICATIONS_SOCKET_NAMESPACE=/notifications

# Optional: widget embed script origin shown in dashboard install snippets
# NEXT_PUBLIC_WIDGET_EMBED_ORIGIN=https://your-dashboard.example.com

# Optional feature flags
# NEXT_PUBLIC_ENABLE_FORGOT_PASSWORD_API=true
