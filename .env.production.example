# Production — copy to `.env.production.local` (never commit secrets).
# Used by `npm run build:prod` / `npm run start:prod`.
# Netlify: Site configuration → Environment variables (Production), then redeploy.
# NEXT_PUBLIC_* values are inlined into the client bundle at build time.
#
# Backend API is on Render (see Convergit_saas/render.yaml + Convergit_saas/docs/render-deploy.md).

NEXT_PUBLIC_API_BASE_URL=https://convergit-saas.onrender.com
NEXT_PUBLIC_CHAT_SOCKET_BASE_URL=https://convergit-saas.onrender.com
NEXT_PUBLIC_CHAT_SOCKET_NAMESPACE=/chat

# Required for production widget install snippets + /embed/widget iframe.
# Must be this Netlify site — NOT the Render API URL.
NEXT_PUBLIC_WIDGET_EMBED_ORIGIN=https://your-app.netlify.app

# Optional: notifications socket (falls back to API base when unset)
# NEXT_PUBLIC_NOTIFICATIONS_SOCKET_BASE_URL=https://convergit-saas.onrender.com
# NEXT_PUBLIC_NOTIFICATIONS_SOCKET_NAMESPACE=/notifications

# Optional feature flags
# NEXT_PUBLIC_ENABLE_FORGOT_PASSWORD_API=true

# Billing — public app URL (payment pages /pay/*)
NEXT_PUBLIC_APP_URL=https://your-app.netlify.app
