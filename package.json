{
  "name": "converge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev",
    "dev:clean": "npm run clean:next && npm run dev",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next build",
    "build:netlify": "npm run check:imports && npm run verify:env:prod && cross-env NETLIFY=true NODE_ENV=production NODE_OPTIONS=--max-old-space-size=8192 next build",
    "build:prod": "npm run check:imports && npm run verify:env:prod && npm run clean:next && cross-env NODE_ENV=production NODE_OPTIONS=--max-old-space-size=8192 next build",
    "check:imports": "node scripts/check-duplicate-imports.mjs",
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next start",
    "start:prod": "cross-env NODE_ENV=production NODE_OPTIONS=--max-old-space-size=4096 next start",
    "verify:env:prod": "node scripts/verify-public-env.mjs",
    "clean:next": "node -e \"const fs=require('fs');for (const d of ['.next-dev','.next-release','.next']) { try { fs.rmSync(d,{recursive:true,force:true}); } catch {} }\"",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^3.9.1",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@mui/material-nextjs": "^9.0.0",
    "@mui/x-date-pickers": "^9.0.2",
    "@mui/x-date-pickers-pro": "^9.0.2",
    "@tanstack/react-query": "^5.99.0",
    "@tsparticles/engine": "^3.9.1",
    "@tsparticles/react": "^3.0.0",
    "axios": "^1.15.0",
    "client-only": "^0.0.1",
    "dayjs": "^1.11.20",
    "engine.io-client": "~6.6.1",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.71.2",
    "react-icons": "^5.6.0",
    "recharts": "^3.8.0",
    "socket.io-client": "^4.8.3",
    "socket.io-parser": "~4.2.4",
    "tsparticles": "^3.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/estree": "^1.0.9",
    "@types/node": "22.19.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "fdir": "^6.5.0",
    "is-number": "^7.0.0",
    "queue-microtask": "^1.2.3",
    "set-function-length": "^1.2.2",
    "storybook": "^8.6.18",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  }
}
