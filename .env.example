# API server root (same host as Swagger, but without /docs). App calls e.g. /health, /auth/login.
# NEXT_PUBLIC_API_BASE_URL=http://192.168.0.100:3000
NEXT_PUBLIC_API_BASE_URL=https://convergit-saas.onrender.com
NEXT_PUBLIC_CHAT_SOCKET_BASE_URL=https://convergit-saas.onrender.com
NEXT_PUBLIC_CHAT_SOCKET_NAMESPACE=/chat

# Optional: iframe embed origin advertised in generated widget scripts (defaults to current window in dashboard).
# NEXT_PUBLIC_WIDGET_EMBED_ORIGIN=https://convergit-saas.onrender.com
