# API server root (same host as Swagger, but without /docs). App calls e.g. /health, /auth/login.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser — never put secrets or private keys here.
#
# Setup (local dev): copy this file to `.env.local` and adjust values.
# Production deploy: copy `.env.production.example` → `.env.production.local`, then `npm run build:prod`.
# Optional feature flag (defaults to false in Storybook if unset)
# NEXT_PUBLIC_ENABLE_FORGOT_PASSWORD_API=true
#
# NEXT_PUBLIC_API_BASE_URL=http://192.168.0.100:3000
NEXT_PUBLIC_API_BASE_URL=https://convergit-saas.onrender.com
# Must match the API host in local dev (same machine that persists messages + emits socket events).
NEXT_PUBLIC_CHAT_SOCKET_BASE_URL=https://convergit-saas.onrender.com
NEXT_PUBLIC_CHAT_SOCKET_NAMESPACE=/chat

# Customer embed host (separate from dashboard): npm run dev:embed → :3003
# NEXT_PUBLIC_WIDGET_EMBED_ORIGIN/widget.js → iframe /embed/widget (same UI as admin preview).
# API config/session still use NEXT_PUBLIC_API_BASE_URL inside the embed page.
NEXT_PUBLIC_WIDGET_EMBED_ORIGIN=http://localhost:3003

# Optional CDN origin for widget.js only (defaults to embed app origin):
# NEXT_PUBLIC_WIDGET_CDN_ORIGIN=https://cdn.example.com

# Fonts: Inter/Manrope load in the browser (not at compile). Set to skip Google when offline/slow network:
# NEXT_FONT_DISABLE_GOOGLE=1
# NEXT_FONT_SYSTEM_ONLY=1
